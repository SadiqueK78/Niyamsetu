# ─────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────

# Byte-compiled files Python creates automatically — not needed in repo
__pycache__/
*.py[cod]
*$py.class

# Virtual environment folder — each person creates their own locally
venv/
env/
.env/
.venv/

# Environment variables file — contains secrets, NEVER push this
.env

# Distribution / packaging
dist/
build/
*.egg-info/

# Pytest cache
.pytest_cache/
*.log

# ─────────────────────────────────────────
# NODE / REACT FRONTEND
# ─────────────────────────────────────────

# node_modules has 150,000+ files — everyone installs their own via npm install
node_modules/

# Vite build output — generated, not source code
frontend/dist/
frontend/.vite/

# ─────────────────────────────────────────
# PROJECT DATA — LOCAL ONLY
# ─────────────────────────────────────────

# The evaluation corpus is published with the repo so results can be
# reproduced: the 25 GAD GR text exports (public, from orgpedia/mahGRs) in
# grdocs/, their FAISS index in vectorstore/, and generated summaries.
# Uploaded PDFs are still kept out; add a public corpus deliberately.
backend/data/grdocs/*.pdf

# Timestamped vector store backups written beside the live index.
backend/data/vectorstore_backup_*/

# ─────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────

# MongoDB local data directory if running locally
data/db/

# SQLite files if used for testing
*.db
*.sqlite3

# ─────────────────────────────────────────
# EDITORS & OS
# ─────────────────────────────────────────

# VS Code settings — personal preference, not project config
.vscode/
*.code-workspace

# Mac OS junk files
.DS_Store

# Windows thumbnail cache
Thumbs.db

# JetBrains IDEs (PyCharm, WebStorm)
.idea/

# ─────────────────────────────────────────
# TEST OUTPUT
# ─────────────────────────────────────────

# Generated HTML report from test runner
tests/GR_Test_Report.html
backend/tests/*_results.json

# Harness capture files are named harness_results_<timestamp>.json, which the
# pattern above does NOT match — it requires the name to END in _results.json.
# They are run records, not source, and one per run adds up fast.
backend/tests/harness_results_*.json
backend/gr_structure_scan.csv