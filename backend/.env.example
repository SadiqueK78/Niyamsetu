# backend/.env.example
# ─────────────────────────────────────────────────────────
# Template for backend/.env — copy it and fill in real values:
#
#     cp .env.example .env
#
# This file is COMMITTED. The real .env is gitignored. Never put a real
# secret, connection string, or password in here.
#
# Every variable below is read by backend/config.py (class Settings).
# Two are REQUIRED and have no default — the server will not start
# without them. The rest are optional: leave them out entirely and the
# default shown in the comment is used. Values here are the defaults,
# written explicitly so a new deployer can see what they are.
# ─────────────────────────────────────────────────────────


# ── REQUIRED ──────────────────────────────────────────────
# The app fails to start if either of these is missing.

# MongoDB connection string. Local install, Docker, or an Atlas SRV URI.
# Atlas form: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017

# Secret used to sign JWT login tokens. Anyone holding this can forge a
# token for ANY user, including an admin — treat it like a password.
# Use a long random string, unique per environment. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string


# ── Database ──────────────────────────────────────────────

# Database name inside the MongoDB instance. (default: niyamsetu)
DATABASE_NAME=niyamsetu


# ── CORS ────────────────────────────────────────────────

# Browser origins allowed to call this API, comma-separated.
#
# NEVER set this to "*". allow_credentials is enabled in main.py, and a
# wildcard combined with credentials makes Starlette reflect whatever
# Origin a caller sent back as "allowed" — every cross-site preflight
# from any website then succeeds. It also lets any site read the
# response of every unauthenticated endpoint.
#
# The default below is the Vite dev server, named explicitly. In normal
# local development the frontend reaches the API through Vite's /api
# proxy, which is same-origin and never triggers CORS at all, so this
# matters for direct calls: Swagger at /docs, a browser-run fetch, or a
# production build served without that proxy.
#
# Deployments set their real front-end origin, scheme included:
#     CORS_ALLOWED_ORIGINS=https://niyamsetu.example.gov.in
# Several origins are comma-separated, no spaces needed:
#     CORS_ALLOWED_ORIGINS=https://a.example.gov.in,https://b.example.gov.in
# (default: http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173


# ── Authentication ────────────────────────────────────────

# Hours before a login token expires and the user must sign in again.
# (default: 24)
JWT_EXPIRE_HOURS=24

# Whether the app may create the built-in demo accounts on startup, and
# only when the users collection is empty. Those accounts and their
# passwords are written in the source, so anyone who reads the repo can
# log into a deployment that started from an empty database.
#
#   true  — local development. Clone, run, log in. (default)
#   false — ANY deployment that is not a developer laptop: public demo,
#           staging, production. Create a real admin account instead.
#
# Setting this to false does NOT delete accounts that were already
# seeded; it only stops new ones being created.
SEED_DEFAULT_USERS=true


# ── Ollama (local LLM runtime) ────────────────────────

# Where the Ollama server is listening. Kept on localhost because this
# system is meant to run fully on-premise — no document text leaves the
# machine. (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Model that turns text into vectors for retrieval. Changing this makes
# every existing vector unreadable — the index must be rebuilt from
# scratch afterwards. (default: nomic-embed-text)
#
# This deployment currently runs bge-m3 instead:
#     EMBEDDING_MODEL=bge-m3
# It is multilingual and 1024-dimensional, where nomic-embed-text is
# English-first and 768. On a Marathi GR corpus that matters. The
# dimension change is exactly why switching forces a full re-embed — a
# 1024-dim query vector cannot be searched against a 768-dim index.
EMBEDDING_MODEL=nomic-embed-text

# Model that writes the answers. (default: phi4-mini)
#
# This deployment currently runs:
#     LLM_MODEL=qwen2.5:7b
# Note that is qwen2.5, NOT qwen2.5-coder — the coder variant is
# code-specialised, and this corpus is Marathi government prose.
# Whichever you pick must actually be pulled on the host that
# OLLAMA_BASE_URL points at. A name that is not there fails only at
# generation time, one question into a run, so check first with:
#     curl $OLLAMA_BASE_URL/api/tags
LLM_MODEL=phi4-mini

# Hard ceiling on a single LLM call, in seconds. Without it the Ollama
# client waits forever, and an abandoned generation keeps blocking every
# later request because Ollama serialises on the model. (default: 620.0)
LLM_TIMEOUT=620.0

# Context window, in tokens, pinned explicitly. Left unset, Ollama sizes
# the context per request and restarts the model whenever the tier
# changes, which can fail outright on a loaded machine. (default: 8192)
LLM_NUM_CTX=8192

# How long Ollama keeps the model in memory after a request. Ollama's own
# default of 5m unloads it during a normal pause in a chat, so the next
# question pays a full reload. (default: 30m)
LLM_KEEP_ALIVE=30m


# ── Remote LLM Provider (e.g., Google Colab) ────────────

# URL for the remote inference API (e.g., https://your-colab-url.ngrok.io)
# Leave empty to use local Ollama (default behavior)
COLAB_API_URL=

# API key for the remote inference API
# Format: X-API-Key: <secret> header
COLAB_API_KEY=

# Hard ceiling on a single remote LLM call, in seconds.
# Without this, requests could hang indefinitely.
COLAB_LLM_TIMEOUT=60.0


# ── Retrieval / RAG ─────────────────────────────────────
# Changing CHUNK_SIZE or CHUNK_OVERLAP only affects documents embedded
# AFTER the change — rebuild the vector store to apply them everywhere.

# Fallback chunk size in characters. Used for documents where no
# structural section marker is detected, and as the ceiling when a
# section is too long to embed whole. (default: 800)
CHUNK_SIZE=800

# Characters carried over between adjacent chunks and across section
# boundaries, so a fact split across a boundary still appears whole in at
# least one chunk. (default: 150)
CHUNK_OVERLAP=150

# How many chunks are retrieved and sent to the LLM per question.
# (default: 12)
TOP_K=12

# How many previous conversation turns are included as context.
# (default: 6)
CONTEXT_WINDOW=6


# ── Retrieval and answer experiments ────────────────────
# Every flag below is off, or set to the value that reproduces the old
# behaviour. With all of them untouched this deployment behaves exactly
# as it did before they existed.

# Narrow the LLM's context to the few source files that dominate the
# ranking instead of passing every retrieved chunk. (default: false)
ROUTE_ENABLED=false

# How many source files survive routing. (default: 3)
ROUTE_TOP_DOCS=3

# How deep to retrieve before routing scores the files. (default: 30)
ROUTE_POOL_K=30

# Ceiling on how many chunks routing passes through. (default: 8)
ROUTE_MAX_CHUNKS=8

# Prepend each kept file's header chunk, so the LLM sees the GR number,
# date and department that body chunks leave out. (default: false)
HEADER_INJECT=false

# Ask the LLM for synonym phrasings of the question and retrieve on all
# of them. Costs one extra LLM call per question. (default: false)
QUERY_REWRITE=false

# Hard ceiling on that rewrite call, in seconds. (default: 25.0)
QUERY_REWRITE_TIMEOUT=25.0

# Second LLM pass that checks the answer against the context it was
# generated from, and refuses instead of answering unsupported claims.
# (default: false)
ANSWER_VERIFY=false

# Hard ceiling on that verification call, in seconds. (default: 40.0)
VERIFY_TIMEOUT=40.0

# Pull in chunks from documents the retrieved ones are linked to in the GR
# relationship graph, such as a superseding order. (default: false)
GRAPH_EXPAND=false

# Number of top-ranked distinct files whose graph neighbours may be added.
# (default: 2)
GRAPH_SEED_DOCS=2

# How many linked documents may contribute chunks to one answer. (default: 2)
GRAPH_MAX_NEIGHBOR_DOCS=2

# How many chunks are taken from each linked document. (default: 3)
GRAPH_CHUNKS_PER_NEIGHBOR=3

# Answer header questions (date, department, GR number) directly from the
# extracted metadata table, with no retrieval and no LLM call.
# (default: false)
META_FASTPATH=false

# Latin-script queries skip BM25 and use the dense ranking alone. (default: false)
SCRIPT_AWARE_FUSION=false

# Map-reduce document summaries with a numeric faithfulness check. (default: false)
SUMMARY_V2_ENABLED=false

# Characters of chunk text per summary MAP call. (default: 5000)
SUMMARY_BATCH_CHARS=5000

# Most MAP calls per document; extra text joins the last batch. (default: 12)
SUMMARY_MAX_BATCHES=12

# Rewrite a follow-up plus recent history into a standalone question for
# retrieval only. One extra LLM call per follow-up. (default: false)
HISTORY_REWRITE=false

# Recent exchanges (user + assistant) the rewrite reads. (default: 2)
HISTORY_REWRITE_TURNS=2

# Ceiling on the rewrite call, in seconds. (default: 60)
HISTORY_REWRITE_TIMEOUT=60

# Output token ceiling for chat answers only; 0 means no ceiling. (default: 800)
LLM_NUM_PREDICT=800

# Rerank retrieved chunks with a cross-encoder before they reach the LLM.
# Needs sentence-transformers; the model downloads on first use. (default: false)
RERANK_ENABLED=false

# Cross-encoder model name. (default: BAAI/bge-reranker-v2-m3)
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Chunks retrieved for the reranker to score. (default: 20)
RERANK_CANDIDATES=20

# Chunks kept after reranking, sent to the LLM and cited. (default: 5)
RERANK_TOP_N=5


# ── Local file storage ────────────────────────────────────

# Base directory for uploaded PDFs, the FAISS index, and generated
# summaries, relative to the backend/ folder. The grdocs/, vectorstore/
# and summaries/ subfolders are created automatically on startup.
# (default: ./data)
DATA_DIR=./data